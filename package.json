{
  "name": "crash-test",
  "version": "0.0.0",
  "description": "Behavioural crash-tests and signed attestations for open agentic websites (site, CLI and MCP).",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "crash-test": "node --env-file-if-exists=.env src/cli.js",
    "build:site": "esbuild site/src/main.js --bundle --format=esm --platform=browser --target=es2022 --outfile=site/app.js --legal-comments=linked"
  },
  "bin": {
    "crash-test": "src/cli.js"
  },
  "dependencies": {
    "agent-trust-kit": "github:FrankPonce/agent-trust-kit",
    "canonicalize": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
