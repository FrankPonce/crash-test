# Copy to .env (git-ignored) and fill in. Never commit or share your key.
# Any OpenAI-compatible router works. Default: hosted Otari.
CRASHTEST_ROUTER=https://api.otari.ai/api/v1
CRASHTEST_API_KEY=
CRASHTEST_MODEL=alibaba/qwen3.8-flash

# Tester identity, for --attest. The private key is a secret: keep it outside the repo.
CRASHTEST_SIGNING_KEY=
CRASHTEST_ORIGIN=
