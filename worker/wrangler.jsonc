{
  // Crash-test site: static tester page + free default model for browser runs.
  //   npx wrangler deploy        Secret (once): npx wrangler secret put SESSION_SECRET
  "name": "crashtest",
  "main": "src/index.js",
  "compatibility_date": "2026-05-01",
  // Live MCP checks fetch other sites, including our own Workers on this account
  // (charge., sketchy.). Without this flag those same-account fetches don't go over the
  // public internet and come back 404.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp"],
    "not_found_handling": "404-page"
  },
  "ai": { "binding": "AI" },
  // Results database (M4.1). Schema: migrations/. Apply with
  //   npx wrangler d1 migrations apply crashtest --remote
  // Uploads need a bearer token: npx wrangler secret put INGEST_TOKEN
  "d1_databases": [
    { "binding": "DB", "database_name": "crashtest", "database_id": "a2b69085-d9aa-49ae-a357-bb1a47361708", "migrations_dir": "migrations" }
  ],
  // A full browser run is about 25 model calls, so limits are per session and per IP.
  "ratelimits": [
    { "name": "SESSION_LIMIT", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LLM_LIMIT", "namespace_id": "2002", "simple": { "limit": 40, "period": 60 } },
    { "name": "LLM_IP_LIMIT", "namespace_id": "2003", "simple": { "limit": 60, "period": 60 } },
    // MCP (M4.2): reads per IP, and live static checks (which fetch other sites) per IP.
    { "name": "MCP_LIMIT", "namespace_id": "2004", "simple": { "limit": 120, "period": 60 } },
    { "name": "STATIC_LIMIT", "namespace_id": "2005", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
